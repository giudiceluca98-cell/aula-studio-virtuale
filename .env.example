# Dalla schermata Connect del progetto Supabase. La publishable key e' pubblica.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Solo server: non usare mai il prefisso NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
WEBHOOK_SECRET=replace-with-at-least-32-random-characters

# URL pubblico dell'app (in locale oppure Vercel).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Facoltativo: impostare a 1 solo per esplorare l'interfaccia senza Supabase.
NEXT_PUBLIC_DEMO_MODE=0

# Annotazioni e traduzione adattiva. Il lettore TXT di base funziona anche con
# questo flag spento. Non aggiungere mai la chiave del provider al frontend.
NEXT_PUBLIC_ADAPTIVE_READER_ENABLED=0
TRANSLATION_AI_ENABLED=false
TRANSLATION_PROVIDER=disabled
TRANSLATION_MODEL=
TRANSLATION_DAILY_LIMIT=30
TRANSLATION_MAX_CONTEXT_CHARS=1500
TRANSLATION_CACHE_TTL_DAYS=90
TRANSLATION_TIMEOUT_MS=15000
OPENAI_API_KEY=

# Catalogo locale. Eve ordina materiali reali gia presenti nel database e
# prepara ricerche Google, senza effettuare chiamate OpenAI o consumare credito.
NEXT_PUBLIC_CATALOG_ENABLED=0
CATALOG_ENABLED=false
EVE_CATALOG_ENABLED=false
EVE_CATALOG_MODEL=gpt-5-mini
EVE_SEARCH_INTERPRETATION_ENABLED=false
EVE_WEB_SEARCH_ENABLED=false
EVE_WEB_SEARCH_MODEL=gpt-5-mini
EVE_AUTOMATIC_CURRICULUM_ENABLED=false
EVE_CURRICULUM_MODEL=gpt-5.6-sol
EVE_CURRICULUM_TIMEOUT_MS=60000
EVE_PATH_MODEL=gpt-5.6-terra
EVE_PATH_AI_ENABLED=false
EVE_DAILY_REQUEST_LIMIT_PER_USER=20
EVE_REQUEST_TIMEOUT_MS=20000

# Router OpenAI server-side. Sol resta disattivato finché non viene completato
# il flusso di consenso monouso; non impostare mai queste variabili come pubbliche.
OPENAI_MODEL_LUNA=gpt-5.6-luna
OPENAI_MODEL_TERRA=gpt-5.6-terra
OPENAI_MODEL_SOL=gpt-5.6-sol
AI_ROUTING_DEFAULT_MODE=automatic
AI_LUNA_ENABLED=true
AI_TERRA_ENABLED=true
AI_SOL_ENABLED=false
AI_SOL_CONFIRMATION_REQUIRED=true
AI_DAILY_REQUEST_LIMIT_PER_USER=30
AI_MAX_CONTEXT_CHARS=1500
AI_REQUEST_TIMEOUT_MS=15000
MODEL_PRICE_LUNA_INPUT_PER_MTOK=1
MODEL_PRICE_LUNA_CACHED_INPUT_PER_MTOK=0.1
MODEL_PRICE_LUNA_OUTPUT_PER_MTOK=6
MODEL_PRICE_TERRA_INPUT_PER_MTOK=2.5
MODEL_PRICE_TERRA_CACHED_INPUT_PER_MTOK=0.25
MODEL_PRICE_TERRA_OUTPUT_PER_MTOK=15
MODEL_PRICE_SOL_INPUT_PER_MTOK=5
MODEL_PRICE_SOL_CACHED_INPUT_PER_MTOK=0.5
MODEL_PRICE_SOL_OUTPUT_PER_MTOK=30

# CORE-1.2 — adapter server-side verso i prototipi FastAPI di Eve.
# Rimane disattivato finché l'endpoint interno non è configurato e approvato.
# Il token non deve mai usare il prefisso NEXT_PUBLIC_.
EVE_CORE_INTEGRATION_ENABLED=false
EVE_CORE_SERVICE_URL=http://127.0.0.1:8000
EVE_CORE_SERVICE_TIMEOUT_MS=3000
EVE_CORE_SERVICE_MAX_RESPONSE_BYTES=262144
EVE_CORE_SERVICE_TOKEN=

# CORE-1.3 — database Eve; entrambi OFF finché migrazione e backup non sono verificati.
EVE_PRODUCTION_DATABASE_ENABLED=false
EVE_SQLITE_IMPORT_ENABLED=false

# CORE-1.4 — context builder server-side. Nessun segreto reale va committato.
EVE_CONTEXT_BUILDER_ENABLED=false
EVE_CONTEXT_MAX_SELECTED_CHARS=4000
EVE_CONTEXT_MAX_AUTHORIZED_MATERIALS=20
EVE_CONTEXT_TOKEN_TTL_SECONDS=300
EVE_CONTEXT_SHARED_SELECTION_ENABLED=false
EVE_CONTEXT_SIGNING_SECRET=
