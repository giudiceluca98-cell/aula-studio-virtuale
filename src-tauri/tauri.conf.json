{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aula Studio Virtuale",
  "version": "1.4.0-alpha.2",
  "identifier": "it.aulastudiovirtuale.desktop",
  "build": {
    "beforeDevCommand": "pnpm build:desktop",
    "beforeBuildCommand": "pnpm build:desktop",
    "frontendDist": "../desktop-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Aula Studio Virtuale",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": false,
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": [
          "Italian",
          "English"
        ]
      }
    }
  }
}
