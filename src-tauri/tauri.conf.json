{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aula Studio Virtuale",
  "version": "1.4.0-alpha.4",
  "identifier": "it.aulastudiovirtuale.desktop",
  "build": {
    "beforeDevCommand": "pnpm build:desktop",
    "beforeBuildCommand": "pnpm build:desktop",
    "frontendDist": "../desktop-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Aula Studio Virtuale",
        "width": 1180,
        "height": 700,
        "minWidth": 760,
        "minHeight": 520,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#050b14"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": false,
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": [
          "Italian",
          "English"
        ]
      }
    }
  }
}
