{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "/demo-aula-studio-virtuale-canonica.html"
    },
    {
      "source": "/dashboard",
      "destination": "/demo-aula-studio-virtuale-canonica.html"
    },
    {
      "source": "/catalog",
      "destination": "/demo-aula-studio-virtuale-canonica.html"
    },
    {
      "source": "/room/:path*",
      "destination": "/demo-aula-studio-virtuale-canonica.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
