{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Eve AI Studio",
  "version": "1.2.0-alpha.6",
  "identifier": "it.aulastudio.eveai",
  "build": {
    "beforeDevCommand": "node scripts/build-frontend.mjs",
    "beforeBuildCommand": "node scripts/build-frontend.mjs",
    "frontendDist": "../frontend-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' https:; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    },
    "windows": [
      {
        "label": "main",
        "title": "Eve AI Studio",
        "width": 1280,
        "height": 800,
        "minWidth": 860,
        "minHeight": 580,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark",
        "backgroundColor": "#050b14"
      }
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [],
      "pubkey": ""
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": [
          "Italian",
          "English"
        ]
      }
    }
  }
}
